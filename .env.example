# Yoyo Travel — environment variables
# Copy to .env.local and fill in what you have. Every integration is optional:
# without keys the app still runs (demo mode for user data, chat shows
# matching places from our own data and explains what is missing).
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are sent to browsers.

# ── Site ───────────────────────────────────────────────────────────────
# Public base URL (used for metadata / OAuth redirect allow-list)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Auth with Google, Postgres + RLS, Storage) ───────────────
# Project Settings → API. The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Do NOT add the service_role key to this app. It is not needed and must
# never be exposed to client code.

# ── AI chat (server-side only; pick one) ────────────────────────────────
# AI_PROVIDER=gemini | openai   (optional; defaults to whichever key is set, Gemini first)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible gateway
OPENAI_BASE_URL=

# ── Web search for AI chat (server-side only) ──────────────────────────
BRAVE_SEARCH_API_KEY=

# Requests per minute per IP for /api/chat (in-memory, per server instance)
CHAT_RATE_LIMIT_PER_MIN=8

# ── Map tiles (optional) ────────────────────────────────────────────────
# Default: OpenStreetMap standard tiles (fine for low traffic; see the OSM
# tile usage policy). For production traffic use a tile provider and set:
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# ── Data sync scripts (local only) ─────────────────────────────────────
# Contact string added to the User-Agent sent to Wikimedia/Overpass
SYNC_CONTACT=
# Optional alternative Overpass endpoint
OVERPASS_URL=
